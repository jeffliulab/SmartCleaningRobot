<?xml version="1.0"?>
<!--
  Office environment for Gazebo.
  Matches training scene: 20m x 20m, open plan with cubicles.
  Scene bounds: (-10, -10) to (10, 10) — same as scene_cfg.py OFFICE_SCENE.
-->
<sdf version="1.6">
  <world name="office">

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <physics type="ode">
      <real_time_factor>1</real_time_factor>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- ============ Outer Walls (20m x 20m) ============ -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 10 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.4 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.88 0.87 0.84 1</ambient></material></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.4 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.88 0.87 0.84 1</ambient></material></visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>10 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 20.4 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 20.4 2.5</size></box></geometry>
          <material><ambient>0.88 0.87 0.84 1</ambient></material></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 20.4 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 20.4 2.5</size></box></geometry>
          <material><ambient>0.88 0.87 0.84 1</ambient></material></visual>
      </link>
    </model>

    <!-- ============ Conference Room (NE corner, 6m x 5m) ============ -->
    <model name="conf_wall_w">
      <static>true</static>
      <pose>4 7.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 5 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 5 2.5</size></box></geometry>
          <material><ambient>0.80 0.82 0.85 1</ambient></material></visual>
      </link>
    </model>

    <!-- South wall with door gap (gap at x=6..8) -->
    <model name="conf_wall_s_left">
      <static>true</static>
      <pose>5.5 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3 0.15 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 0.15 2.5</size></box></geometry>
          <material><ambient>0.80 0.82 0.85 1</ambient></material></visual>
      </link>
    </model>

    <model name="conf_wall_s_right">
      <static>true</static>
      <pose>9 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2 0.15 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2 0.15 2.5</size></box></geometry>
          <material><ambient>0.80 0.82 0.85 1</ambient></material></visual>
      </link>
    </model>

    <!-- Conference table -->
    <model name="conf_table">
      <static>true</static>
      <pose>7 7.5 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.4 1.0 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.4 1.0 0.7</size></box></geometry>
          <material><ambient>0.55 0.40 0.30 1</ambient></material></visual>
      </link>
    </model>

    <!-- ============ Break Room (NW corner, 5m x 5m) ============ -->
    <model name="break_wall_e">
      <static>true</static>
      <pose>-5 7.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 5 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 5 2.5</size></box></geometry>
          <material><ambient>0.80 0.82 0.85 1</ambient></material></visual>
      </link>
    </model>

    <model name="break_wall_s_left">
      <static>true</static>
      <pose>-9 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2 0.15 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2 0.15 2.5</size></box></geometry>
          <material><ambient>0.80 0.82 0.85 1</ambient></material></visual>
      </link>
    </model>

    <model name="break_wall_s_right">
      <static>true</static>
      <pose>-6 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2 0.15 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2 0.15 2.5</size></box></geometry>
          <material><ambient>0.80 0.82 0.85 1</ambient></material></visual>
      </link>
    </model>

    <!-- Break room table -->
    <model name="break_table">
      <static>true</static>
      <pose>-7.5 7.5 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 1.2 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 1.2 0.7</size></box></geometry>
          <material><ambient>0.55 0.40 0.30 1</ambient></material></visual>
      </link>
    </model>

    <!-- ============ Cubicle Area (south half, y from -9 to 2) ============ -->

    <!-- Vertical cubicle partitions (1.2m high) -->
    <model name="cub_v1">
      <static>true</static>
      <pose>-6 -3 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.08 5 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.08 5 1.2</size></box></geometry>
          <material><ambient>0.70 0.72 0.68 1</ambient></material></visual>
      </link>
    </model>

    <model name="cub_v2">
      <static>true</static>
      <pose>-2 -3 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.08 5 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.08 5 1.2</size></box></geometry>
          <material><ambient>0.70 0.72 0.68 1</ambient></material></visual>
      </link>
    </model>

    <model name="cub_v3">
      <static>true</static>
      <pose>2 -3 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.08 5 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.08 5 1.2</size></box></geometry>
          <material><ambient>0.70 0.72 0.68 1</ambient></material></visual>
      </link>
    </model>

    <model name="cub_v4">
      <static>true</static>
      <pose>6 -3 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.08 5 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.08 5 1.2</size></box></geometry>
          <material><ambient>0.70 0.72 0.68 1</ambient></material></visual>
      </link>
    </model>

    <!-- Horizontal cubicle partitions -->
    <model name="cub_h_left">
      <static>true</static>
      <pose>-4 -5.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4 0.08 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4 0.08 1.2</size></box></geometry>
          <material><ambient>0.70 0.72 0.68 1</ambient></material></visual>
      </link>
    </model>

    <model name="cub_h_mid">
      <static>true</static>
      <pose>0 -5.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4 0.08 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4 0.08 1.2</size></box></geometry>
          <material><ambient>0.70 0.72 0.68 1</ambient></material></visual>
      </link>
    </model>

    <model name="cub_h_right">
      <static>true</static>
      <pose>4 -5.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4 0.08 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4 0.08 1.2</size></box></geometry>
          <material><ambient>0.70 0.72 0.68 1</ambient></material></visual>
      </link>
    </model>

    <!-- ============ Desks ============ -->
    <model name="desk_1">
      <static>true</static>
      <pose>-4 -2 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.6 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.6 0.7</size></box></geometry>
          <material><ambient>0.55 0.40 0.30 1</ambient></material></visual>
      </link>
    </model>

    <model name="desk_2">
      <static>true</static>
      <pose>0 -2 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.6 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.6 0.7</size></box></geometry>
          <material><ambient>0.55 0.40 0.30 1</ambient></material></visual>
      </link>
    </model>

    <model name="desk_3">
      <static>true</static>
      <pose>4 -2 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.6 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.6 0.7</size></box></geometry>
          <material><ambient>0.55 0.40 0.30 1</ambient></material></visual>
      </link>
    </model>

    <model name="desk_4">
      <static>true</static>
      <pose>-4 -7 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.6 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.6 0.7</size></box></geometry>
          <material><ambient>0.55 0.40 0.30 1</ambient></material></visual>
      </link>
    </model>

    <model name="desk_5">
      <static>true</static>
      <pose>0 -7 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.6 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.6 0.7</size></box></geometry>
          <material><ambient>0.55 0.40 0.30 1</ambient></material></visual>
      </link>
    </model>

    <model name="desk_6">
      <static>true</static>
      <pose>4 -7 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.6 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.6 0.7</size></box></geometry>
          <material><ambient>0.55 0.40 0.30 1</ambient></material></visual>
      </link>
    </model>

    <!-- ============ Misc Furniture ============ -->

    <!-- Printer in common area -->
    <model name="printer">
      <static>true</static>
      <pose>0 3 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.8</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
      </link>
    </model>

    <!-- Filing cabinet -->
    <model name="cabinet">
      <static>true</static>
      <pose>8 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.8 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.8 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>

  </world>
</sdf>
